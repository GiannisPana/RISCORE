# Environment Variables for RISCORE
# Copy this file to .env and fill in your credentials

# =============================================================================
# Hugging Face Configuration
# =============================================================================
# Required for accessing gated models (Llama, Mistral, etc.)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# =============================================================================
# API Keys (Optional - only needed for API-based models)
# =============================================================================

# OpenAI API Key
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models)
# Get at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere API Key
# Get at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Replicate API Token
# Get at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# =============================================================================
# Model Configuration (Optional)
# =============================================================================

# Default model to use
DEFAULT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Enable 4-bit quantization by default (saves memory)
USE_QUANTIZATION=true

# Device to use (cuda, cpu, or auto)
DEVICE=auto

# =============================================================================
# Data Paths (Optional - uses defaults if not set)
# =============================================================================

# Directory for datasets
DATA_DIR=./data

# Directory for model cache
CACHE_DIR=./cache

# Directory for results
OUTPUT_DIR=./output

# Directory for embeddings cache
EMBEDDINGS_CACHE_DIR=./data/cache

# =============================================================================
# Evaluation Configuration (Optional)
# =============================================================================

# Default dataset type (SP or WP)
DEFAULT_DATASET=SP

# Default number of exemplars for few-shot
DEFAULT_EXEMPLARS=2

# Default temperature for generation
DEFAULT_TEMPERATURE=0.5

# Maximum new tokens to generate
MAX_NEW_TOKENS=700

# =============================================================================
# Logging Configuration (Optional)
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable verbose output
VERBOSE=false
